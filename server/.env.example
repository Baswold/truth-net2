# Truth Net Server Environment Configuration
# Copy this file to .env and configure for your environment

# Application Settings
TRUTHNET_APP_NAME="Truth Net Server"
TRUTHNET_ENVIRONMENT=development  # development, staging, production
TRUTHNET_API_V1_PREFIX=/v1

# Database Configuration
# PostgreSQL connection URL
TRUTHNET_DATABASE_URL=postgresql+psycopg://truthnet:truthnet@localhost:5432/truthnet

# Database Pool Settings
TRUTHNET_DB_POOL_SIZE=5
TRUTHNET_DB_MAX_OVERFLOW=10
TRUTHNET_DB_POOL_RECYCLE=3600
TRUTHNET_DB_POOL_PRE_PING=true

# Redis Configuration
# Used for rate limiting and caching
TRUTHNET_REDIS_URL=redis://localhost:6379/0

# MeiliSearch Configuration
# Full-text search engine
TRUTHNET_SEARCH_URL=http://localhost:7700
TRUTHNET_SEARCH_API_KEY=

# Storage Configuration
# Local file storage path
TRUTHNET_STORAGE_PATH=./storage

# JWT Authentication
# CRITICAL: Generate a secure secret for production
# Generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
TRUTHNET_JWT_SECRET=dev-secret-key-do-not-use-in-production-change-this-immediately
TRUTHNET_JWT_ALGORITHM=HS256
TRUTHNET_ACCESS_TOKEN_EXP_MINUTES=60
TRUTHNET_REFRESH_TOKEN_EXP_MINUTES=43200  # 30 days

# CORS Configuration
# Comma-separated list of allowed origins
TRUTHNET_ALLOW_ORIGINS=http://localhost:1420,tauri://localhost

# Production: Set to your actual frontend domains
# TRUTHNET_ALLOW_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Trusted Hosts (Production)
# Comma-separated list of allowed hosts
TRUTHNET_ALLOWED_HOSTS=localhost,127.0.0.1

# Production: Set to your actual domains
# TRUTHNET_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,api.yourdomain.com

# =============================================================================
# PRODUCTION CHECKLIST
# =============================================================================
# Before deploying to production:
# 1. Set TRUTHNET_ENVIRONMENT=production
# 2. Generate and set a secure TRUTHNET_JWT_SECRET (minimum 32 characters)
# 3. Update TRUTHNET_ALLOW_ORIGINS with your actual frontend URLs
# 4. Update TRUTHNET_ALLOWED_HOSTS with your actual domain(s)
# 5. Use a strong database password in TRUTHNET_DATABASE_URL
# 6. Configure Redis with authentication if exposed
# 7. Set TRUTHNET_SEARCH_API_KEY for MeiliSearch
# 8. Review and adjust pool sizes based on load
# 9. Enable HTTPS/TLS for all connections
# 10. Set up proper monitoring and logging infrastructure
